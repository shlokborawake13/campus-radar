# ============================================================
# Campus Radar — Server Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control!
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campusradar_db
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Authentication & JWT Secrets (MUST be unique, random, 32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_WITH_RANDOM_HEX_64_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_WITH_RANDOM_HEX_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security & CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Panel Secret Gateway Path (change this to a unique random slug!)
# Generate with: node -e "console.log('/admin-' + require('crypto').randomBytes(8).toString('hex'))"
ADMIN_PANEL_SECRET_PATH=/sec-admin-gateway-CHANGE_ME

# OTP Configuration
OTP_EXPIRY_MINUTES=10
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SALT=REPLACE_ME_WITH_RANDOM_HEX_64_CHARS

# TOTP MFA
TOTP_ISSUER=CampusRadar

# Allowed Student Email Domain
ALLOWED_EMAIL_DOMAIN=sanjivani.edu.in

# Supabase (optional)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# SMTP Email Server Configuration (for delivering verification OTPs to students)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Campus Radar" <no-reply@sanjivani.edu.in>
