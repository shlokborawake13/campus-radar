# ============================================================
# Campus Radar — Frontend Environment Variables
# ============================================================

# In local development, leave VITE_API_URL empty or '/api' to use the Vite proxy.
# In production on Vercel, set this to your deployed Render backend URL:
# Example: VITE_API_URL=https://campus-radar-backend.onrender.com/api
VITE_API_URL=/api

# Secret Admin Gateway Path (must match backend ADMIN_PANEL_SECRET_PATH)
VITE_ADMIN_GATEWAY=/sec-admin-gateway-7x9q
